---
import BaseHead from "../components/BaseHead.astro";
import "../styles/site.css";
import { SITE_TITLE, SITE_DESCRIPTION } from "../config";

interface Props {
  active: "home" | "publications" | "cv";
  title?: string;
  description?: string;
  image?: string;
}

const { active, title = SITE_TITLE, description = SITE_DESCRIPTION, image } = Astro.props;

const nav = [
  { id: "home", label: "Home", href: "/" },
  { id: "publications", label: "Publications", href: "/publications" },
  { id: "cv", label: "CV", href: "/cv" },
];

const year = new Date().getFullYear();
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title={title} description={description} image={image} />
    <meta name="google-site-verification" content="6rFXzqXbYKcgqdETtDqJOM4Usl1T-OKRQiuI5UtmNm8" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Archivo:wdth,wght@62..125,400..700&family=IBM+Plex+Mono:wght@400;500;600&family=Source+Serif+4:ital,opsz,wght@0,8..60,300..600;1,8..60,300..600&display=swap"
    />
    <script is:inline>
      // Apply a saved theme before first paint to avoid a flash.
      try {
        var saved = localStorage.getItem("dg-theme");
        if (saved === "dark" || saved === "light") document.documentElement.setAttribute("data-theme", saved);
      } catch (e) {}
    </script>
  </head>
  <body>
    <div class="shell">
      <aside class="rail">
        <div>
          <a href="/" aria-label="Home">
            <img class="portrait" src="/portrait.jpg" width="720" height="720" alt="Dimitrios Gerogiannis" />
          </a>
          <p class="rail-name">Dimitrios Gerogiannis</p>
          <p class="rail-role">PhD Candidate<br />Imperial College London</p>
        </div>

        <nav class="rail-nav" aria-label="Sections">
          {
            nav.map((item) => (
              <a class="nav-link" href={item.href} aria-current={item.id === active ? "page" : undefined}>
                {item.label}
              </a>
            ))
          }
        </nav>

        <div class="rail-spacer"></div>

        <div class="socials">
          <a href="mailto:d.gerogiannis22@imperial.ac.uk" aria-label="Email" title="Email">
            <svg viewBox="0 0 24 24"><path d="M4 4h16c1.103 0 2 .897 2 2v12c0 1.103-.897 2-2 2H4c-1.103 0-2-.897-2-2V6c0-1.103.897-2 2-2zm8 6l8-4H4l8 4zm8 2V8l-8 4-8-4v4l8 4 8-4z"></path></svg>
          </a>
          <a href="https://scholar.google.com/citations?hl=en&user=hih2fgEAAAAJ" target="_blank" rel="noopener" aria-label="Google Scholar" title="Google Scholar">
            <svg viewBox="0 0 24 24"><path d="M12 14.5 3 8.2 12 2l9 6.2-9 6.3zM5.2 11.4 12 16l6.8-4.6v3.9c0 2.7-3 4.7-6.8 4.7s-6.8-2-6.8-4.7v-3.9z"></path></svg>
          </a>
          <a href="https://github.com/dimgerogiannis" target="_blank" rel="noopener" aria-label="GitHub" title="GitHub">
            <svg viewBox="0 0 24 24"><path fill-rule="evenodd" clip-rule="evenodd" d="M12.026 2c-5.509 0-9.974 4.465-9.974 9.974 0 4.406 2.857 8.145 6.821 9.465.499.09.679-.217.679-.481 0-.237-.008-.865-.011-1.696-2.775.602-3.361-1.338-3.361-1.338-.452-1.152-1.107-1.459-1.107-1.459-.905-.619.069-.605.069-.605 1.002.07 1.527 1.028 1.527 1.028.89 1.524 2.336 1.084 2.902.829.091-.645.351-1.085.635-1.334-2.214-.251-4.542-1.107-4.542-4.93 0-1.087.389-1.979 1.024-2.675-.101-.253-.446-1.268.099-2.64 0 0 .837-.269 2.742 1.021a9.582 9.582 0 0 1 2.496-.336 9.554 9.554 0 0 1 2.496.336c1.906-1.291 2.742-1.021 2.742-1.021.545 1.372.203 2.387.099 2.64.64.696 1.024 1.587 1.024 2.675 0 3.833-2.33 4.675-4.552 4.922.355.308.675.916.675 1.846 0 1.334-.012 2.41-.012 2.737 0 .267.178.577.687.479C19.146 20.115 22 16.379 22 11.974 22 6.465 17.535 2 12.026 2z"></path></svg>
          </a>
          <a href="https://www.linkedin.com/in/dimitrios-gerogiannis-070a3424b/" target="_blank" rel="noopener" aria-label="LinkedIn" title="LinkedIn">
            <svg viewBox="0 0 24 24"><circle cx="4.983" cy="5.009" r="2.188"></circle><path d="M9.237 8.855v12.139h3.769v-6.003c0-1.584.298-3.118 2.262-3.118 1.937 0 1.961 1.811 1.961 3.218v5.904H21v-6.657c0-3.27-.704-5.783-4.526-5.783-1.835 0-3.065 1.007-3.568 1.96h-.051v-1.66H9.237zm-6.142 0H6.87v12.139H3.095z"></path></svg>
          </a>
        </div>
      </aside>

      <main>
        <div class="topbar">
          <button class="theme-toggle" id="theme-toggle" type="button" aria-label="Switch theme" title="Switch theme">
            <svg class="i-sun" viewBox="0 0 24 24" aria-hidden="true">
              <circle cx="12" cy="12" r="4.2"></circle>
              <path d="M12 2.4v2.4M12 19.2v2.4M21.6 12h-2.4M4.8 12H2.4M18.8 5.2l-1.7 1.7M6.9 17.1l-1.7 1.7M18.8 18.8l-1.7-1.7M6.9 6.9 5.2 5.2"></path>
            </svg>
            <svg class="i-moon" viewBox="0 0 24 24" aria-hidden="true">
              <path d="M20.5 14.4A8.6 8.6 0 0 1 9.6 3.5a8.6 8.6 0 1 0 10.9 10.9z"></path>
            </svg>
          </button>
        </div>

        <div class="page">
          <slot />

          <footer class="site">
            <span>&copy; {year} Dimitrios Gerogiannis</span>
          </footer>
        </div>
      </main>
    </div>

    <div class="toast" id="toast" role="status" aria-live="polite"></div>

    <script>
      const root = document.documentElement;
      const toggle = document.getElementById("theme-toggle");
      const darkQuery = window.matchMedia("(prefers-color-scheme: dark)");

      const isDark = () => {
        const set = root.getAttribute("data-theme");
        return set ? set === "dark" : darkQuery.matches;
      };
      const sync = () => {
        toggle?.classList.toggle("is-dark", isDark());
        window.dispatchEvent(new Event("dg:theme"));
      };

      sync();
      toggle?.addEventListener("click", () => {
        const next = isDark() ? "light" : "dark";
        root.setAttribute("data-theme", next);
        try {
          localStorage.setItem("dg-theme", next);
        } catch {
          /* storage unavailable */
        }
        sync();
      });
      darkQuery.addEventListener("change", sync);

      // BibTeX: toggle the panel, copy its text.
      const toast = document.getElementById("toast");
      let toastTimer: number | undefined;
      const showToast = (message: string) => {
        if (!toast) return;
        toast.textContent = message;
        toast.classList.add("is-on");
        window.clearTimeout(toastTimer);
        toastTimer = window.setTimeout(() => toast.classList.remove("is-on"), 1800);
      };

      document.addEventListener("click", (event) => {
        const target = event.target as HTMLElement;

        const toggleBtn = target.closest<HTMLElement>("[data-bib-toggle]");
        if (toggleBtn) {
          const panel = document.getElementById(toggleBtn.dataset.bibToggle ?? "");
          const open = panel?.classList.toggle("is-open") ?? false;
          toggleBtn.setAttribute("aria-expanded", String(open));
          return;
        }

        const copyBtn = target.closest<HTMLElement>("[data-bib-copy]");
        if (copyBtn) {
          const text = document.getElementById(copyBtn.dataset.bibCopy ?? "")?.textContent ?? "";
          if (!navigator.clipboard) {
            showToast("Copy blocked — select the text instead");
            return;
          }
          navigator.clipboard
            .writeText(text)
            .then(() => showToast("BibTeX copied"))
            .catch(() => showToast("Copy blocked — select the text instead"));
        }
      });
    </script>
  </body>
</html>
