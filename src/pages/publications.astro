---
import SiteLayout from "../layouts/SiteLayout.astro";
import PubCard from "../components/site/PubCard.astro";
import { publications } from "../data/publications";
---

<SiteLayout active="publications" title="Dimitrios Gerogiannis | Publications">
  <h2 class="page-title">Publications</h2>
  <p class="page-lede">
    You can also access my
    <a href="https://scholar.google.com/citations?hl=en&user=hih2fgEAAAAJ" target="_blank" rel="noopener">Google Scholar profile here</a>.
  </p>
  <div class="pubs">
    {publications.map((pub) => <PubCard pub={pub} />)}
  </div>
</SiteLayout>
