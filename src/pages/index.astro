---
import SiteLayout from "../layouts/SiteLayout.astro";
import HeroMesh from "../components/site/HeroMesh.astro";
import PubCard from "../components/site/PubCard.astro";
import { publications } from "../data/publications";

const selected = publications.filter((pub) => pub.selected);

const keywords = ["3D Human Modeling", "Diffusion Models", "Video Models", "Distillation"];
---

<SiteLayout active="home" image="/Arc2Avatar.jpeg">
  <div class="hero">
    <HeroMesh />
    <p class="eyebrow">Imperial College London &middot; Department of Computing</p>
    <h1>Dimitrios Gerogiannis</h1>
    <p class="hero-sub">PhD candidate working on <strong>digital humans</strong>.</p>

    <div class="bio">
      <p>
        Hi, I'm Dimitrios, but most people, including me, prefer to call me Dimitris. I am a PhD candidate in the
        <a href="https://www.imperial.ac.uk/computing" target="_blank" rel="noopener">Department of Computing</a> at
        <a href="https://www.imperial.ac.uk" target="_blank" rel="noopener">Imperial College London</a>, supervised by
        <a href="https://www.imperial.ac.uk/people/s.zafeiriou" target="_blank" rel="noopener">Professor Stefanos Zafeiriou</a>.
        My research lies at the intersection of Machine Learning, Computer Vision, and Graphics, with a particular focus on
        Digital Humans.
      </p>
      <p>
        Prior to beginning my PhD, I graduated with a Diploma (BSc+MEng) in Computer Science from the
        <a href="https://www.ceid.upatras.gr/en/" target="_blank" rel="noopener">Computer Engineering and Informatics Department</a> at the
        <a href="https://www.upatras.gr/en/" target="_blank" rel="noopener">University of Patras</a>, where I was advised by
        <a href="http://xanthippi.ceid.upatras.gr/people/psarakis/personal_gr.php" target="_blank" rel="noopener">Professor Emmanouil Z. Psarakis</a>
        for my thesis.
      </p>
    </div>

    <div class="tags">
      {keywords.map((keyword) => <span class="tag">{keyword}</span>)}
    </div>
  </div>

  <section class="section">
    <div class="section-head">
      <h2>Research Interests</h2>
    </div>
    <div class="grid-2">
      <div class="topic">
        <h4>Controllable Limited-View 3D Avatars</h4>
        <p>
          Creating animatable 3D avatars from sparse visual observations, with a particular emphasis on single, in-the-wild 
          images. I am interested in combining modern 3D representations with strong generative priors to reconstruct observed 
          appearance while plausibly completing unobserved regions. A central goal is to produce highly realistic avatars that 
          remain controllable and can reproduce facial expressions, speech-driven motion, head pose, and broader human motion.
        </p>
      </div>
      <div class="topic">
        <h4>Diffusion Models</h4>
        <p>
          Large-scale (foundation) image diffusion models as powerful generative priors, as well as diffusion models that operate 
          directly in 3D representation spaces, including meshes and other structured geometric representations. I am particularly
          interested in how their learned priors can be transferred to downstream avatar generation tasks.
      </div>
      <div class="topic">
        <h4>Video Models</h4>
        <p>
          Controllable generative video models for human-centric tasks such as animation and reenactment, driven by explicit conditioning 
          signals such as audio and parametric head-model parameters, as well as learned implicit features, with a focus on their potential 
          for real-time, streaming 2D avatars.
        </p>
      </div>
      <div class="topic">
        <h4>Distillation</h4>
        <p>
          Distilling the knowledge of strong image and video diffusion models into 3D, through both optimization-based approaches such as score 
          distillation sampling and self-distillation into efficient generative models for 3D representations, so their potential carries over 
          to 3D generation.
        </p>
      </div>
      <div class="topic">
        <h4>PII-Free Solutions</h4>
        <p>
          Human data is inherently sensitive. One of my priorities is reducing reliance on real-person data by fine-tuning large generative priors on 
          synthetic human data, aiming to achieve realistic results while minimizing the use of personally identifiable data and bridging the synthetic-to-real domain gap.
        </p>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="section-head">
      <h2>News</h2>
      <span class="meta">Latest first</span>
    </div>
    <div class="news">
      <div class="news-item">
        <span class="news-date">Feb 2026</span>
        <span>Started as a <strong>Student Researcher</strong> at <strong>Google AR/VR</strong>, London!</span>
      </div>
      <div class="news-item">
        <span class="news-date">Jun 2025</span>
        <span>Joined <strong>Meta Reality Labs</strong>, London, as a <strong>Research Scientist Intern</strong>!</span>
      </div>
      <div class="news-item">
        <span class="news-date">Feb 2025</span>
        <span><strong>Arc2Avatar</strong> accepted at <strong>CVPR 2025</strong>!</span>
      </div>
      <div class="news-item">
        <span class="news-date">Jul 2024</span>
        <span><strong>AnimateMe</strong> accepted at <strong>ECCV 2024</strong>!</span>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="section-head">
      <h2>Selected Publications</h2>
      <a class="meta" href="/publications">All publications &rarr;</a>
    </div>
    <div class="pubs">
      {selected.map((pub) => <PubCard pub={pub} />)}
    </div>
  </section>
</SiteLayout>
