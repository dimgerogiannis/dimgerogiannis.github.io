---
import SiteLayout from "../layouts/SiteLayout.astro";
import CvItem from "../components/site/CvItem.astro";
---

<SiteLayout active="cv" title="Dimitrios Gerogiannis | CV">
  <h2 class="page-title">Curriculum Vitae</h2>
  <p class="page-lede">Education, professional experience, and awards.</p>

  <section class="section" style="margin-top: 0;">
    <div class="section-head"><h2>Education</h2></div>
    <div class="timeline">
      <CvItem
        date="2022 – 2027"
        title="PhD in Computing"
        org="Imperial College London"
        orgUrl="https://www.imperial.ac.uk/"
        place="London, United Kingdom"
        items={["3D Human Modeling", "Diffusion Models", "Video Models", "Distillation"]}
        noteLabel="Supervisor"
        noteName="Professor Stefanos Zafeiriou"
        noteUrl="https://www.imperial.ac.uk/people/s.zafeiriou"
      />
      <CvItem
        date="2017 – 2022"
        title="BSc + MEng in Computer Science"
        org="University of Patras"
        orgUrl="https://www.upatras.gr/en/"
        place="Patras, Greece"
        items={[
          "GPA: 9.15/10 — Valedictorian, Class of 2022",
          "Diploma thesis: Robust image alignment under severe photometric distortions",
        ]}
        noteLabel="Advisor"
        noteName="Professor Emmanouil Z. Psarakis"
        noteUrl="http://xanthippi.ceid.upatras.gr/people/psarakis/personal_gr.php"
      />
    </div>
  </section>

  <section class="section">
    <div class="section-head"><h2>Professional Experience</h2></div>
    <div class="timeline">
      <CvItem
        date="Feb 2026 – Sep 2026"
        title="Student Researcher"
        org="Google"
        orgUrl="https://arvr.google.com"
        place="London, United Kingdom"
        logo="/google_arvr.png"
        logoAlt="Google AR and VR"
      />
      <CvItem
        date="Jun 2025 – Dec 2025"
        title="Research Scientist Intern"
        org="Meta"
        orgUrl="https://tech.facebook.com/reality-labs/"
        place="London, United Kingdom"
        logo="/meta_reality_labs.png"
        logoAlt="Meta Reality Labs"
      />
      <CvItem
        date="Jan 2024 – May 2025"
        title="Research Scientist Intern"
        org="Alloyed Limited"
        orgUrl="https://alloyed.com/"
        place="Oxford, United Kingdom"
        logo="/alloyed.png"
        logoAlt="Alloyed"
      />
      <CvItem
        date="Oct 2022 – Present"
        title="Graduate Teaching Assistant"
        org="Imperial College London"
        orgUrl="https://www.imperial.ac.uk/computing/"
        place="London, United Kingdom"
        logo="/imperial.png"
        logoAlt="Imperial College London"
      />
    </div>
  </section>

  <section class="section">
    <div class="section-head"><h2>Awards and Honors</h2></div>
    <div class="timeline">
      <CvItem
        date="2022 – 2027"
        title="Doctoral Scholarship Award"
        org="DoC, Imperial College London"
        orgUrl="https://www.imperial.ac.uk/computing/"
        place="London, United Kingdom"
        items={[
          "Full scholarship covering tuition fees and a living stipend for the duration of the PhD program, awarded to students with strong distinction in their MSc degrees.",
        ]}
      />
      <CvItem
        date="2022 – 2023"
        title="Student Excellence Award"
        org="States Scholarships Foundation"
        orgUrl="https://www.iky.gr/en/"
        place="Athens, Greece"
        items={["Awarded to the students achieving the highest GPA in their respective departments nationwide."]}
      />
      <CvItem
        date="2022 – 2023"
        title="Graduate Excellence Honors"
        org="University of Patras"
        orgUrl="https://www.upatras.gr/en/"
        place="Patras, Greece"
        items={["Granted to the graduates who achieved the highest GPAs in their respective departments and classes."]}
      />
    </div>
  </section>
</SiteLayout>
