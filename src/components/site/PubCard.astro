---
import { ME, type Publication } from "../../data/publications";

interface Props {
  pub: Publication;
}

const { pub } = Astro.props;
const bibId = `bib-${pub.id}`;
const bibTextId = `bib-text-${pub.id}`;
---

<article class="pub">
  <a class="pub-fig" href={pub.url} target="_blank" rel="noopener">
    <img src={pub.teaser} width={pub.teaserWidth} height={pub.teaserHeight} alt={`${pub.title} teaser`} loading="lazy" />
  </a>
  <div>
    <p class="pub-venue">{pub.venue}</p>
    <h3><a href={pub.url} target="_blank" rel="noopener">{pub.title}</a></h3>
    <p class="authors">
      {
        pub.authors.map((author, i) => (
          <><a href={author.url} target="_blank" rel="noopener" class={author.name === ME ? "me" : undefined}>{author.name}</a>{i < pub.authors.length - 1 && <span aria-hidden="true">, </span>}</>
        ))
      }
    </p>
    <p class="pub-info">{pub.info}</p>
    <div class="pub-actions">
      {
        pub.links.map((link) => (
          <a class="action" href={link.url} target="_blank" rel="noopener">
            {link.label}
          </a>
        ))
      }
      <button class="action" type="button" data-bib-toggle={bibId} aria-controls={bibId} aria-expanded="false">BibTeX</button>
    </div>
    <div class="bibtex" id={bibId}>
      <button class="bib-copy" type="button" data-bib-copy={bibTextId}>Copy</button>
      <pre id={bibTextId}>{pub.bibtex}</pre>
    </div>
  </div>
</article>
